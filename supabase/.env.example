# Supabase Edge Functions environment variables
# Set these via: supabase secrets set KEY=value

# Core (auto-set by Supabase in production)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Push notifications (APNs)
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_PRIVATE_KEY=base64_encoded_p8_key
APNS_BUNDLE_ID=com.tarsy.ios
APNS_PRODUCTION=false

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Tarsy <hello@yourdomain.com>

# App Store Server API (receipt verification)
APP_STORE_ISSUER_ID=your_issuer_id
APP_STORE_KEY_ID=your_key_id
APP_STORE_PRIVATE_KEY=base64_encoded_p8_key
APP_STORE_BUNDLE_ID=com.tarsy.ios

# UltraContext (optional)
ULTRACONTEXT_API_KEY=your_ultracontext_api_key
